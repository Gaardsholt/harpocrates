{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "forkProcessing": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^vault/.*\\.go$"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>.*?)\\sdepName=(?<depName>.*?)\\s+.*?\"(?<currentValue>.*?)\""
      ]
    }
  ]
}
